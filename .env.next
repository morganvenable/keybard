# Bleeding edge: svalboard/keybard main, built on every merge and served at
# https://svalboard.github.io/keybard-next/ (see .github/workflows/next-deploy.yml).
# Its own storage, so it never shares saved layouts or backups with other apps on
# svalboard.github.io.
VITE_BASE_PATH=/keybard-next/
VITE_STORAGE_NAMESPACE=keybard-next
VITE_CHANNEL=next
